{
  "name": "virtual-ta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Virtual TA MVP — one unified chat box, an LLM intent router, four skills (coach / in-class / author / review) over a shared core. Runs entirely on the instructor's laptop.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "unpdf": "^1.3.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
