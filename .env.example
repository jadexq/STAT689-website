# Configuration for both servers.
#
# LOCAL: each project reads its OWN .env — copy the relevant sections into
#   virtual_ta/.env  and  virtual_space/.env
# CLOUD RUN: there are no .env files. Everything below is set as an
#   environment variable or a Secret Manager reference on the service, and
#   both servers share it (they run in one container).
#
# Never commit a filled-in copy of this file.

# ─────────────────────────────────────────────────────────────
# Identity & access  (virtual_space)
# ─────────────────────────────────────────────────────────────

# Set to 1 ONLY when the service sits behind Google IAP. It makes the
# X-Goog-Authenticated-User-Email header authoritative. Leave unset
# locally: a header any client can set is not a login.
TRUST_IAP_HEADER=

# Comma-separated instructor allowlist. These accounts may switch to the
# admin role (drive Terra, post to boards, open the lecture mic).
# Behind IAP, leaving this empty means NOBODY is an instructor.
# Locally it defaults to DEV_USER, so the admin panel just works.
ADMIN_EMAILS=jade@example.com

# Avatar display names: "email:Name" pairs. Without an entry, the name is
# guessed from the address ("sam.chen1998@gmail.com" -> "Sam Chen").
ROSTER=sam@example.com:Sam,ben@example.com:Ben

# Who you are when NOT behind IAP. Override per browser tab with ?as=…
# to test as several students at once. Ignored when TRUST_IAP_HEADER=1.
DEV_USER=jade@local

# ─────────────────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────────────────

# Root for everything mutable — chat logs, boards, generated notes/slides.
# Unset (local): each project uses its own data/ and output/ folders.
# Cloud Run: point at the mounted GCS bucket, e.g. /data. The container
# filesystem is ephemeral, so anything not under here is lost on restart.
DATA_DIR=

# ─────────────────────────────────────────────────────────────
# Wiring
# ─────────────────────────────────────────────────────────────

PORT=2567                            # space: 2567 local, 8080 on Cloud Run
TA_BASE_URL=http://localhost:3000    # where the space finds the TA brain

# ─────────────────────────────────────────────────────────────
# Models & tokens  (Secret Manager in the cloud — never plain env vars)
# ─────────────────────────────────────────────────────────────

LLM_PROVIDER=ollama
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=                        # read-only, for the PR review skill
