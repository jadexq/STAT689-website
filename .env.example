# Configuration for both servers.
#
# LOCAL: each project reads its OWN .env — copy the relevant sections into
#   virtual_ta/.env  and  virtual_space/.env
# CLOUD RUN: there are no .env files. Everything below is set as an
#   environment variable or a Secret Manager reference on the service, and
#   both servers share it (they run in one container).
#
# Never commit a filled-in copy of this file.

# ─────────────────────────────────────────────────────────────
# Identity & access  (virtual_space)
# ─────────────────────────────────────────────────────────────

# Set to 1 ONLY when the service sits behind Google IAP. It makes the
# X-Goog-Authenticated-User-Email header authoritative. Leave unset
# locally: a header any client can set is not a login.
TRUST_IAP_HEADER=

# Comma-separated instructor allowlist. These accounts may switch to the
# admin role (drive Terra, post to boards, open the lecture mic).
# Behind IAP, leaving this empty means NOBODY is an instructor.
# Locally it defaults to DEV_USER, so the admin panel just works.
ADMIN_EMAILS=jade@example.com

# Which student character (and therefore which office) each address
# controls: "email=slot" pairs. Slots are s1..s6 — opaque handles, not
# names. Assigning a slot deletes its AI stand-in and hands the office to
# that person. An address with NO slot lands in the Common Area and is
# refused every handout, so a missing entry here is not a small mistake.
STUDENTS=sam@example.com=s1,ben@example.com=s2

# Display names: "email:Name" pairs. This is the ONLY place a real student's
# name may live — the roster file is tracked in git. It names the avatar, the
# office door, the `Roster:` startup line and the handout dashboard, all four.
# Required behind IAP for every address STUDENTS assigns: without one the
# server refuses to boot rather than label a person with a character's
# placeholder. Locally it warns. Keep names short — an office label is drawn
# inside a 6x6 room.
ROSTER=sam@example.com:Sam,ben@example.com:Ben

# Who you are when NOT behind IAP. Override per browser tab with ?as=…
# to test as several students at once. Ignored when TRUST_IAP_HEADER=1.
DEV_USER=jade@local

# ─────────────────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────────────────

# Root for everything mutable — chat logs, boards, generated notes/slides.
# Unset (local): each project uses its own data/ and output/ folders.
# In the container: a plain writable directory (the image sets /data).
# NOT a mounted bucket — appending JSONL through GCS FUSE rewrites the whole
# object per line, which GCS throttles and bills per write. docker/sync.mjs
# owns the cloud relationship instead. See the plan doc, §14f.
DATA_DIR=

# Where DATA_DIR is snapshotted for durability. Unset = no sync at all,
# which is what you want locally. The container's filesystem is ephemeral
# (and in RAM), so in the cloud this is the only thing making data durable.
#   gs://stat689-data/state      — Cloud Storage, auth from the instance
#   file:///some/dir             — a plain directory; used by the tests
SNAPSHOT_URI=

# How often the snapshot may be uploaded, in milliseconds. Only fires when
# something actually changed, so an idle room costs nothing. 2 minutes keeps
# a month of flushes at roughly a third of the 5,000-write free tier and
# caps any crash loss at two minutes. See §14j.
SNAPSHOT_FLUSH_MS=120000

# ─────────────────────────────────────────────────────────────
# Wiring
# ─────────────────────────────────────────────────────────────

PORT=2567                            # space: 2567 local, 8080 on Cloud Run
TA_BASE_URL=http://localhost:3000    # where the space finds the TA brain

# ─────────────────────────────────────────────────────────────
# Models & tokens  (Secret Manager in the cloud — never plain env vars)
# ─────────────────────────────────────────────────────────────

LLM_PROVIDER=ollama
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=                        # read-only, for the PR review skill
